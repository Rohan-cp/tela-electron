{
  "name": "tela",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "packageManager": "yarn@4.0.0",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:prod": "cross-env NODE_ENV=production ELECTRON_IS_DEV=false electron-vite dev",
    "build": "yarn typecheck && electron-vite build",
    "build:prod": "yarn typecheck && cross-env NODE_ENV=production electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "yarn build && electron-builder --dir",
    "build:unpack:prod": "yarn build:prod && electron-builder --dir",
    "build:win": "yarn build && electron-builder --win",
    "build:win:prod": "yarn build:prod && electron-builder --win",
    "build:mac": "yarn build && electron-builder --mac --arm64",
    "build:mac:prod": "yarn build:prod && electron-builder --mac --arm64",
    "build:mac:universal": "yarn build && electron-builder --mac --x64 --arm64",
    "build:mac:universal:prod": "yarn build:prod && electron-builder --mac --x64 --arm64",
    "build:linux": "yarn build && electron-builder --linux",
    "build:linux:prod": "yarn build:prod && electron-builder --linux",
    "setup:env": "node setup-env.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.1",
    "@electron-toolkit/utils": "3.0.0",
    "@solana/web3.js": "1.95.3",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-query-devtools": "5.90.2",
    "dotenv": "^17.2.3",
    "quill": "2.0.2",
    "react-icons": "5.5.0",
    "react-quill": "2.0.0",
    "react-router-dom": "6.26.2",
    "styled-components": "6.1.13",
    "ts-node": "10.9.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "2.0.0",
    "@electron-toolkit/eslint-config-ts": "2.0.0",
    "@electron-toolkit/tsconfig": "1.0.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "cross-env": "^10.1.0",
    "electron": "31.0.2",
    "electron-builder": "24.13.3",
    "electron-builder-squirrel-windows": "24.13.3",
    "electron-vite": "2.3.0",
    "eslint": "8.56.0",
    "eslint-plugin-react": "7.34.3",
    "prettier": "3.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.2",
    "vite": "5.3.1"
  },
  "build": {
    "appId": "com.tela.app",
    "productName": "Tela",
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
